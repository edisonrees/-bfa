# Flask
PORT=8080
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this

# Mock Instagram API proxy
MOCK_API_BASE_URL=https://instagram.mockapis.com/v1/api/mock/com.instgram.com

# instaloader / rate limits
INSTAGRAM_RATE_LIMIT=60
INSTAGRAM_TIMEOUT=10
MAX_RETRIES=2
RETRY_DELAY=1
MAX_CONCURRENT_CHECKS=5
BATCH_SIZE=100

# Caps / streaming (100 million default)
MAX_PASSWORDS=100000000
MAX_FILE_SIZE=2147483648
STREAM_THRESHOLD=50000

# Keep TOTAL_REPLICAS=1 unless you mount a shared UPLOAD_FOLDER volume.
# Railway horizontal replicas without shared storage will hide tasks/results.
REPLICA_ID=0
TOTAL_REPLICAS=1
